module neorv32_imem_rom (
  clk_i_d,
  \imem_req.stb ,
  \io_req.addr ,
  rdata_Z
)
;
input clk_i_d;
input \imem_req.stb ;
input [13:2] \io_req.addr ;
output [31:0] rdata_Z;
wire [31:4] DO;
wire [31:4] DO_0;
wire [31:4] DO_1;
wire [31:4] DO_2;
wire [31:4] DO_3;
wire [31:4] DO_4;
wire [31:4] DO_5;
wire [31:4] DO_6;
wire VCC;
wire GND;
  pROM rdata_Z_0_s (
    .DO({DO[31:4],rdata_Z[3:0]}),
    .AD({\io_req.addr [13:2],GND,GND}),
    .CLK(clk_i_d),
    .CE(\imem_req.stb ),
    .OCE(GND),
